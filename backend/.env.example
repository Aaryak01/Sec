# Copy to .env for local development. All of these are optional — the app
# degrades gracefully without them (see README's "Local development" table
# for what each one enables/disables).

COHERE_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only needed to point at a different Cognito pool than this project's
# default (baked into api.py).
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=

# Stripe TEST MODE keys only — see the comment in api.py above
# stripe.api_key. Never put a live (sk_live_...) key here.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

FRONTEND_URL=http://localhost:3000
